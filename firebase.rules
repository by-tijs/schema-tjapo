rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/schemaTjapo/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == "DYdNsg9kvTQ1DqQaTJK0HjUUPeD2"
        && request.auth.uid == userId;
    }

    match /users/{userId}/perfectDay/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/mijnCode/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
